# ====================================================================
# RIK SpaceHub - Environment Configuration (Supabase & Authentication)
# ====================================================================

# 1. Buka dashboard Supabase di https://supabase.com/dashboard/project/_/settings/api
# 2. Salin Project URL dan Project API Anon/Public Key Anda ke bawah:

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# CATATAN KEAMANAN & PRAKTIK TERBAIK:
# - Jangan pernah memasukkan 'service_role key' (secret key) ke dalam file frontend (.env).
#   Gunakan hanya 'anon' (public) key yang aman untuk browser.
# - Jika variabel ini dibiarkan kosong atau berupa placeholder di atas, RIK SpaceHub
#   otomatis berjalan dalam Mode Simulasi Lokal (Demo Mode) yang terisolasi di browser Anda.
